<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
		<PackageReference Include="Asmichi.ChildProcess" />
		<PackageReference Include="NUnit" />
		<PackageReference Include="NUnit.ConsoleRunner" GeneratePathProperty="true" />
		<PackageReference Include="NUnit.Extension.NUnitV2ResultWriter" GeneratePathProperty="true" />
		<PackageReference Include="NUnitLite" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ThreeCS.TestOut.CommandInvoker\ThreeCS.TestOut.CommandInvoker.csproj" />
		<ProjectReference Include="..\ThreeCS.TestOut.Core\ThreeCS.TestOut.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="$(PkgNUnit_ConsoleRunner)\tools\**\*.*" Condition="'$(PkgNUnit_ConsoleRunner)' != ''" Link="NUnitTools\%(RecursiveDir)%(Filename)%(Extension)" visible="false">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="$(PkgNUnit_Extension_NUnitV2ResultWriter)\tools\**\*.*" Condition="'$(PkgNUnit_Extension_NUnitV2ResultWriter)' != ''" Link="NUnitTools\%(RecursiveDir)%(Filename)%(Extension)" visible="false">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
